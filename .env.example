# Copiaza acest fisier in .env pentru testare locala (NU comite .env in git).

# Obligatoriu — cheia API Anthropic (platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Obligatoriu pentru trimitere email — cheia API Resend (resend.com -> API Keys)
RESEND_API_KEY=re_...

# Optional — adresa "From" (implicit: onboarding@resend.dev, functional fara domeniu propriu)
EMAIL_FROM=AI Daily Brief <onboarding@resend.dev>

# Optional — destinatari, separati prin virgula (implicit: cele doua adrese ale lui Calin)
EMAIL_TO=calinsomcutean@gmail.com,calin.somcutean@leadder.ro

# Optional — modelul Claude folosit pentru triaj (implicit: claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# Optional — cate ore in urma sa acopere colectarea (implicit: 30)
HOURS_LOOKBACK=30

# Optional — URL-ul public al arhivei (GitHub Pages), folosit pentru linkul din footer-ul emailului
ARCHIVE_BASE_URL=https://<user>.github.io/<repo>
